; Implicit arguments. A def's type may start with implicit binders
; `(pi {A} TYPE ...)`: their names are in scope in the body, and an
; application `(app f a ...)` infers them from the explicit arguments'
; types. `(@ f)` takes them explicitly. Elaboration only guesses; every
; term is checked as written out.
(def refl (pi {A} (u 0) (pi x A (path A x x))) (lam x A (plam i x)))
(def sym (pi {A} (u 0) (pi {x} A (pi {y} A (pi p (path A x y) (path A y x)))))
  (lam p (path A x y) (plam i (papp p (neg i)))))
(def trans (pi {A} (u 0) (pi {x} A (pi {y} A (pi {z} A
             (pi p (path A x y) (pi q (path A y z) (path A x z)))))))
  (lam p (path A x y) (lam q (path A y z)
    (plam i (hcomp j A (((= i 0) x) ((= i 1) (papp q j))) (papp p i))))))
(def ap (pi {A} (u 0) (pi {B} (u 0) (pi {x} A (pi {y} A
          (pi f (pi a A B) (pi p (path A x y) (path B (app f x) (app f y))))))))
  (lam f (pi a A B) (lam p (path A x y) (plam i (app f (papp p i))))))

(def not (pi b bool bool) (lam b bool (bif c bool bfalse btrue b)))
(check ap-not (app ap not (app refl btrue)) (path bool bfalse bfalse))
(equal sym-sym (app sym (app sym (app refl 3))) (app refl 3) (path nat 3 3))
(check there-and-back (app trans (app refl 2) (app sym (app refl 2))) (path nat 2 2))
(check given (app (@ sym) nat 1 1 (app refl 1)) (path nat 1 1))

; Implicit arguments of a parameterized type, through a definition that
; computes to a pi.
(def isProp (pi A (u 0) (u 0)) (lam A (u 0) (pi a A (pi b A (path A a b)))))
(data (ptrunc A) (inc A) (squash (x (ptrunc A)) (y (ptrunc A)) (path x y)))
(def ptrunc-isProp (pi {A} (u 0) (app isProp (ptrunc A)))
  (lam a (ptrunc A) (lam b (ptrunc A) (plam i (squash a b i)))))
(def squash-back (pi {A} (u 0) (pi a (ptrunc A) (pi b (ptrunc A) (path (ptrunc A) b a))))
  (lam a (ptrunc A) (lam b (ptrunc A) (app sym (app (@ ptrunc-isProp) A a b)))))
