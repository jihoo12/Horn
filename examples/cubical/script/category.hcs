; Wild precategories (lib/category.hcs): the category of types satisfies
; its laws by refl, and the opposite category reverses morphisms and is an
; involution judgmentally.
(import ../lib/category.hcs)
(check cmp-id (lam C Cat (lam x (app Ob C) (app cmp C x x x (app id C x) (app id C x))))
  (pi C Cat (pi x (app Ob C) (app Hom C x x))))
(check types-hom (app Hom Types nat bool) (u 0))
; Through the opposite category: its morphisms are the original's reversed,
; and twice reversed, its objects are the original's.
(check hom-op (lam C Cat (lam x (app Ob C) (lam y (app Ob C) (plam i (app Hom C y x)))))
  (pi C Cat (pi x (app Ob C) (pi y (app Ob C) (path (u 0) (app Hom (app op C) x y) (app Hom C y x))))))
(check ob-op-op (lam C Cat (plam i (app Ob C)))
  (pi C Cat (path (u 1) (app Ob (app op (app op C))) (app Ob C))))
; Reversing twice gives the category back, judgmentally: every component of
; op (op C) computes to C's (the laws through sym (sym p) = p), and the
; whole structure is C by eta.
(check op-op (lam C Cat (plam i C)) (pi C Cat (path Cat (app op (app op C)) C)))
