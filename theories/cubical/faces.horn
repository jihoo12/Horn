; Additive extension of path.horn. No changes to the general checker.
; Free distributive face lattice with (i=0) /\ (i=1) = false.
; There is deliberately NO rule (i=0) \/ (i=1) = true.
(sort F)
(sort Fs)
(ctor ff () F)
(ctor ft () F)
(ctor at0 (N) F)
(ctor at1 (N) F)
(ctor fand (F F) F)
(ctor for (F F) F)
(ctor fnil () Fs)
(ctor fc (F Fs) Fs)
(pred face (N F))
(pred member (F Fs))
(pred take (Fs F Fs))
(pred cover (Fs F))
(pred entails (N F F))
(pred boundary (I F F))
(pred local (N F I I))
(pred req (N Ctx F Tm Tm Tm))

(rule face.ff () (face ?d ff))
(rule face.ft () (face ?d ft))
(rule face.0 ((interval ?d (dim ?n))) (face ?d (at0 ?n)))
(rule face.1 ((interval ?d (dim ?n))) (face ?d (at1 ?n)))
(rule face.and ((face ?d ?a) (face ?d ?b)) (face ?d (fand ?a ?b)))
(rule face.or ((face ?d ?a) (face ?d ?b)) (face ?d (for ?a ?b)))

; Auxiliary sequents: conjunction of a list entails a face.
; No algorithmic oracle: every extraction and every branch is certified.
(rule member.here () (member ?a (fc ?a ?rest)))
(rule member.there ((member ?a ?rest)) (member ?a (fc ?b ?rest)))
(rule take.here () (take (fc ?a ?rest) ?a ?rest))
(rule take.there ((take ?rest ?a ?out)) (take (fc ?b ?rest) ?a (fc ?b ?out)))
(rule cover.top () (cover ?ctx ft))
(rule cover.hit ((member ?a ?ctx)) (cover ?ctx ?a))
(rule cover.absurd ((member ff ?ctx)) (cover ?ctx ?a))
(rule cover.clash ((member (at0 ?n) ?ctx) (member (at1 ?n) ?ctx)) (cover ?ctx ?a))
(rule cover.and-left ((take ?ctx (fand ?a ?b) ?rest) (cover (fc ?a (fc ?b ?rest)) ?c))
  (cover ?ctx ?c))
(rule cover.or-left ((take ?ctx (for ?a ?b) ?rest)
    (cover (fc ?a ?rest) ?c) (cover (fc ?b ?rest) ?c)) (cover ?ctx ?c))
(rule cover.and-right ((cover ?ctx ?a) (cover ?ctx ?b)) (cover ?ctx (fand ?a ?b)))
(rule cover.or-right0 ((cover ?ctx ?a)) (cover ?ctx (for ?a ?b)))
(rule cover.or-right1 ((cover ?ctx ?b)) (cover ?ctx (for ?a ?b)))
(rule entails.checked ((face ?d ?a) (face ?d ?b) (cover (fc ?a fnil) ?b))
  (entails ?d ?a ?b))

; Endpoint-face interpretation of de Morgan interval expressions.
; These are face formulas, not Boolean truth tables for interval equality.
(rule boundary.0 () (boundary i0 ft ff))
(rule boundary.1 () (boundary i1 ff ft))
(rule boundary.dim () (boundary (dim ?n) (at0 ?n) (at1 ?n)))
(rule boundary.neg ((boundary ?r ?r0 ?r1)) (boundary (neg ?r) ?r1 ?r0))
(rule boundary.meet ((boundary ?r ?r0 ?r1) (boundary ?s ?s0 ?s1))
  (boundary (meet ?r ?s) (for ?r0 ?s0) (fand ?r1 ?s1)))
(rule boundary.join ((boundary ?r ?r0 ?r1) (boundary ?s ?s0 ?s1))
  (boundary (join ?r ?s) (fand ?r0 ?s0) (for ?r1 ?s1)))

; Local interval equality. Restrictions can be weakened or covered by cases.
(rule local.global ((face ?d ?phi) (interval ?d ?r) (interval ?d ?s) (ieq ?r ?s))
  (local ?d ?phi ?r ?s))
(rule local.0 ((interval ?d ?r) (boundary ?r ?a ?b) (entails ?d ?phi ?a))
  (local ?d ?phi ?r i0))
(rule local.1 ((interval ?d ?r) (boundary ?r ?a ?b) (entails ?d ?phi ?b))
  (local ?d ?phi ?r i1))
(rule local.sym ((local ?d ?phi ?r ?s)) (local ?d ?phi ?s ?r))
(rule local.trans ((local ?d ?phi ?r ?s) (local ?d ?phi ?s ?t)) (local ?d ?phi ?r ?t))
(rule local.weaken ((entails ?d ?phi ?psi) (local ?d ?psi ?r ?s)) (local ?d ?phi ?r ?s))
(rule local.cases ((entails ?d ?phi (for ?a ?b)) (local ?d ?a ?r ?s) (local ?d ?b ?r ?s))
  (local ?d ?phi ?r ?s))
(rule local.meet ((local ?d ?phi ?r ?r2) (local ?d ?phi ?s ?s2))
  (local ?d ?phi (meet ?r ?s) (meet ?r2 ?s2)))
(rule local.join ((local ?d ?phi ?r ?r2) (local ?d ?phi ?s ?s2))
  (local ?d ?phi (join ?r ?s) (join ?r2 ?s2)))
(rule local.neg ((local ?d ?phi ?r ?s)) (local ?d ?phi (neg ?r) (neg ?s)))

; Restricted typed equality for globally well-typed terms only.
; This is NOT a full typing calculus in restricted contexts.
(rule req.global ((face ?d ?phi) (eq ?d ?g ?t ?s ?a)) (req ?d ?g ?phi ?t ?s ?a))
(rule req.sym ((req ?d ?g ?phi ?t ?s ?a)) (req ?d ?g ?phi ?s ?t ?a))
(rule req.trans ((req ?d ?g ?phi ?t ?s ?a) (req ?d ?g ?phi ?s ?r ?a))
  (req ?d ?g ?phi ?t ?r ?a))
(rule req.pdim ((has ?d ?g ?p (path ?a ?b ?c)) (local ?d ?phi ?r ?s)
    (dsubst ?a z ?r ?ar) (dsubst ?a z ?s ?ar) (has ?d ?g ?ar (u ?l)))
  (req ?d ?g ?phi (papp ?p ?r) (papp ?p ?s) ?ar))
