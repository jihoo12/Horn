; Scoped PathP experiment: dimensions are a separate de Bruijn namespace.
; Standalone theory assembled from DTT + interval + the extension below.
; No face restrictions, composition, Glue, or consistency theorem yet.
; Trusted object theory specification. This is NOT a proof of consistency.
; All schema variables are implicitly universally quantified.
; Object variables are de Bruijn indices; contexts store binder types at entry.
(sort N)
(sort Tm)
(sort Ctx)
(ctor z () N)
(ctor s (N) N)
(ctor u (N) Tm)
(ctor v (N) Tm)
(ctor pi (Tm Tm) Tm)
(ctor lam (Tm) Tm)
(ctor app (Tm Tm) Tm)
(ctor nat () Tm)
(ctor zero () Tm)
(ctor nil () Ctx)
(ctor cons (Tm Ctx) Ctx)
(pred le (N N))
(pred lt (N N))
(pred max (N N N))
(pred shift (Tm N Tm))
(pred subst (Tm N Tm Tm))
(pred lookup (Ctx N Tm))
(pred ctx (N Ctx))
(pred has (N Ctx Tm Tm))
(pred eq (N Ctx Tm Tm Tm))

(rule le.z () (le z ?n))
(rule le.s ((le ?m ?n)) (le (s ?m) (s ?n)))
(rule lt.z () (lt z (s ?n)))
(rule lt.s ((lt ?m ?n)) (lt (s ?m) (s ?n)))
(rule max.z () (max z ?n ?n))
(rule max.sz () (max (s ?n) z (s ?n)))
(rule max.ss ((max ?m ?n ?k)) (max (s ?m) (s ?n) (s ?k)))

; shift(t,k) increments every free index >= k.
(rule shift.u () (shift (u ?l) ?k (u ?l)))
(rule shift.nat () (shift nat ?k nat))
(rule shift.zero () (shift zero ?k zero))
(rule shift.v.lt ((lt ?n ?k)) (shift (v ?n) ?k (v ?n)))
(rule shift.v.ge ((le ?k ?n)) (shift (v ?n) ?k (v (s ?n))))
(rule shift.pi ((shift ?a ?k ?a2) (shift ?b (s ?k) ?b2))
  (shift (pi ?a ?b) ?k (pi ?a2 ?b2)))
(rule shift.lam ((shift ?b (s ?k) ?b2)) (shift (lam ?b) ?k (lam ?b2)))
(rule shift.app ((shift ?f ?k ?f2) (shift ?a ?k ?a2))
  (shift (app ?f ?a) ?k (app ?f2 ?a2)))

; subst(t,k,a) removes variable k, replacing it with a.
; Under a binder, shift the replacement before descending.
(rule subst.u () (subst (u ?l) ?k ?a (u ?l)))
(rule subst.nat () (subst nat ?k ?a nat))
(rule subst.zero () (subst zero ?k ?a zero))
(rule subst.v.hit () (subst (v ?k) ?k ?a ?a))
(rule subst.v.lt ((lt ?n ?k)) (subst (v ?n) ?k ?a (v ?n)))
(rule subst.v.gt ((lt ?k (s ?n))) (subst (v (s ?n)) ?k ?a (v ?n)))
(rule subst.pi ((subst ?a ?k ?r ?a2) (shift ?r z ?r2) (subst ?b (s ?k) ?r2 ?b2))
  (subst (pi ?a ?b) ?k ?r (pi ?a2 ?b2)))
(rule subst.lam ((shift ?r z ?r2) (subst ?b (s ?k) ?r2 ?b2))
  (subst (lam ?b) ?k ?r (lam ?b2)))
(rule subst.app ((subst ?f ?k ?r ?f2) (subst ?a ?k ?r ?a2))
  (subst (app ?f ?a) ?k ?r (app ?f2 ?a2)))

(rule lookup.z ((shift ?a z ?a2)) (lookup (cons ?a ?g) z ?a2))
(rule lookup.s ((lookup ?g ?n ?a) (shift ?a z ?a2))
  (lookup (cons ?b ?g) (s ?n) ?a2))
(rule ctx.nil () (ctx ?d nil))
(rule ctx.cons ((ctx ?d ?g) (has ?d ?g ?a (u ?l))) (ctx ?d (cons ?a ?g)))
(rule type.u ((ctx ?d ?g)) (has ?d ?g (u ?l) (u (s ?l))))
(rule type.nat ((ctx ?d ?g)) (has ?d ?g nat (u z)))
(rule type.zero ((ctx ?d ?g)) (has ?d ?g zero nat))
(rule type.v ((ctx ?d ?g) (lookup ?g ?n ?a)) (has ?d ?g (v ?n) ?a))
(rule type.pi ((has ?d ?g ?a (u ?i)) (has ?d (cons ?a ?g) ?b (u ?j)) (max ?i ?j ?k))
  (has ?d ?g (pi ?a ?b) (u ?k)))
(rule type.lam ((has ?d ?g ?a (u ?i)) (has ?d (cons ?a ?g) ?t ?b) (has ?d (cons ?a ?g) ?b (u ?j)))
  (has ?d ?g (lam ?t) (pi ?a ?b)))
(rule type.app ((has ?d ?g ?f (pi ?a ?b)) (has ?d ?g ?t ?a) (subst ?b z ?t ?c))
  (has ?d ?g (app ?f ?t) ?c))
(rule type.conv ((has ?d ?g ?t ?a) (eq ?d ?g ?a ?b (u ?l)) (has ?d ?g ?b (u ?l)))
  (has ?d ?g ?t ?b))

(rule eq.refl ((has ?d ?g ?t ?a)) (eq ?d ?g ?t ?t ?a))
(rule eq.sym ((eq ?d ?g ?t ?r ?a)) (eq ?d ?g ?r ?t ?a))
(rule eq.trans ((eq ?d ?g ?t ?r ?a) (eq ?d ?g ?r ?s ?a)) (eq ?d ?g ?t ?s ?a))
(rule eq.beta ((has ?d ?g ?a (u ?i)) (has ?d (cons ?a ?g) ?t ?b)
    (has ?d (cons ?a ?g) ?b (u ?j)) (has ?d ?g ?r ?a)
    (subst ?t z ?r ?out) (subst ?b z ?r ?c))
  (eq ?d ?g (app (lam ?t) ?r) ?out ?c))

; Equational theory of bounded distributive de Morgan algebras.
; This is only the interval algebra, NOT cubical typing or a face lattice.
(sort I)
(ctor dim (N) I)
(ctor i0 () I)
(ctor i1 () I)
(ctor meet (I I) I)
(ctor join (I I) I)
(ctor neg (I) I)
(pred ieq (I I))
(rule i.refl () (ieq ?a ?a))
(rule i.sym ((ieq ?a ?b)) (ieq ?b ?a))
(rule i.trans ((ieq ?a ?b) (ieq ?b ?c)) (ieq ?a ?c))
(rule i.meet-cong ((ieq ?a ?a2) (ieq ?b ?b2))
  (ieq (meet ?a ?b) (meet ?a2 ?b2)))
(rule i.join-cong ((ieq ?a ?a2) (ieq ?b ?b2))
  (ieq (join ?a ?b) (join ?a2 ?b2)))
(rule i.neg-cong ((ieq ?a ?b)) (ieq (neg ?a) (neg ?b)))
(rule i.meet-comm () (ieq (meet ?a ?b) (meet ?b ?a)))
(rule i.join-comm () (ieq (join ?a ?b) (join ?b ?a)))
(rule i.meet-assoc () (ieq (meet (meet ?a ?b) ?c) (meet ?a (meet ?b ?c))))
(rule i.join-assoc () (ieq (join (join ?a ?b) ?c) (join ?a (join ?b ?c))))
(rule i.meet-idem () (ieq (meet ?a ?a) ?a))
(rule i.join-idem () (ieq (join ?a ?a) ?a))
(rule i.meet-zero () (ieq (meet ?a i0) i0))
(rule i.meet-one () (ieq (meet ?a i1) ?a))
(rule i.join-zero () (ieq (join ?a i0) ?a))
(rule i.join-one () (ieq (join ?a i1) i1))
(rule i.meet-absorb () (ieq (meet ?a (join ?a ?b)) ?a))
(rule i.join-absorb () (ieq (join ?a (meet ?a ?b)) ?a))
(rule i.meet-dist ()
  (ieq (meet ?a (join ?b ?c)) (join (meet ?a ?b) (meet ?a ?c))))
(rule i.join-dist ()
  (ieq (join ?a (meet ?b ?c)) (meet (join ?a ?b) (join ?a ?c))))
(rule i.neg-zero () (ieq (neg i0) i1))
(rule i.neg-one () (ieq (neg i1) i0))
(rule i.involution () (ieq (neg (neg ?a)) ?a))
(rule i.demorgan-meet () (ieq (neg (meet ?a ?b)) (join (neg ?a) (neg ?b))))
(rule i.demorgan-join () (ieq (neg (join ?a ?b)) (meet (neg ?a) (neg ?b))))


; PathP A a b: A lives under one DIMENSION binder; a,b live outside it.
(ctor path (Tm Tm Tm) Tm)
(ctor plam (Tm) Tm)
(ctor papp (Tm I) Tm)
(pred interval (N I))
(pred ishift (I N I))
(pred isubst (I N I I))
(pred dshift (Tm N Tm))
(pred dsubst (Tm N I Tm))
(pred dshiftctx (Ctx N Ctx))

(rule interval.0 () (interval ?d i0))
(rule interval.1 () (interval ?d i1))
(rule interval.dim ((lt ?n ?d)) (interval ?d (dim ?n)))
(rule interval.neg ((interval ?d ?r)) (interval ?d (neg ?r)))
(rule interval.meet ((interval ?d ?r) (interval ?d ?s)) (interval ?d (meet ?r ?s)))
(rule interval.join ((interval ?d ?r) (interval ?d ?s)) (interval ?d (join ?r ?s)))

(rule ishift.0 () (ishift i0 ?k i0))
(rule ishift.1 () (ishift i1 ?k i1))
(rule ishift.dim.lt ((lt ?n ?k)) (ishift (dim ?n) ?k (dim ?n)))
(rule ishift.dim.ge ((le ?k ?n)) (ishift (dim ?n) ?k (dim (s ?n))))
(rule ishift.neg ((ishift ?r ?k ?r2)) (ishift (neg ?r) ?k (neg ?r2)))
(rule ishift.meet ((ishift ?r ?k ?r2) (ishift ?s ?k ?s2)) (ishift (meet ?r ?s) ?k (meet ?r2 ?s2)))
(rule ishift.join ((ishift ?r ?k ?r2) (ishift ?s ?k ?s2)) (ishift (join ?r ?s) ?k (join ?r2 ?s2)))

(rule isubst.0 () (isubst i0 ?k ?r i0))
(rule isubst.1 () (isubst i1 ?k ?r i1))
(rule isubst.dim.hit () (isubst (dim ?k) ?k ?r ?r))
(rule isubst.dim.lt ((lt ?n ?k)) (isubst (dim ?n) ?k ?r (dim ?n)))
(rule isubst.dim.gt ((lt ?k (s ?n))) (isubst (dim (s ?n)) ?k ?r (dim ?n)))
(rule isubst.neg ((isubst ?s ?k ?r ?s2)) (isubst (neg ?s) ?k ?r (neg ?s2)))
(rule isubst.meet ((isubst ?a ?k ?r ?a2) (isubst ?b ?k ?r ?b2)) (isubst (meet ?a ?b) ?k ?r (meet ?a2 ?b2)))
(rule isubst.join ((isubst ?a ?k ?r ?a2) (isubst ?b ?k ?r ?b2)) (isubst (join ?a ?b) ?k ?r (join ?a2 ?b2)))

; Ordinary shift traverses dimension binders without changing its cutoff.
(rule shift.path ((shift ?a ?k ?a2) (shift ?b ?k ?b2) (shift ?c ?k ?c2))
  (shift (path ?a ?b ?c) ?k (path ?a2 ?b2 ?c2)))
(rule shift.plam ((shift ?t ?k ?t2)) (shift (plam ?t) ?k (plam ?t2)))
(rule shift.papp ((shift ?t ?k ?t2)) (shift (papp ?t ?r) ?k (papp ?t2 ?r)))

; Ordinary substitution crossing a dimension binder lifts dimensions in replacement.
(rule subst.path ((dshift ?r z ?r2) (subst ?a ?k ?r2 ?a2) (subst ?b ?k ?r ?b2) (subst ?c ?k ?r ?c2))
  (subst (path ?a ?b ?c) ?k ?r (path ?a2 ?b2 ?c2)))
(rule subst.plam ((dshift ?r z ?r2) (subst ?t ?k ?r2 ?t2)) (subst (plam ?t) ?k ?r (plam ?t2)))
(rule subst.papp ((subst ?t ?k ?r ?t2)) (subst (papp ?t ?s) ?k ?r (papp ?t2 ?s)))

(rule dshift.u () (dshift (u ?l) ?k (u ?l)))
(rule dshift.v () (dshift (v ?n) ?k (v ?n)))
(rule dshift.nat () (dshift nat ?k nat))
(rule dshift.zero () (dshift zero ?k zero))
(rule dshift.pi ((dshift ?a ?k ?a2) (dshift ?b ?k ?b2)) (dshift (pi ?a ?b) ?k (pi ?a2 ?b2)))
(rule dshift.lam ((dshift ?t ?k ?t2)) (dshift (lam ?t) ?k (lam ?t2)))
(rule dshift.app ((dshift ?f ?k ?f2) (dshift ?t ?k ?t2)) (dshift (app ?f ?t) ?k (app ?f2 ?t2)))
(rule dshift.path ((dshift ?a (s ?k) ?a2) (dshift ?b ?k ?b2) (dshift ?c ?k ?c2))
  (dshift (path ?a ?b ?c) ?k (path ?a2 ?b2 ?c2)))
(rule dshift.plam ((dshift ?t (s ?k) ?t2)) (dshift (plam ?t) ?k (plam ?t2)))
(rule dshift.papp ((dshift ?t ?k ?t2) (ishift ?r ?k ?r2)) (dshift (papp ?t ?r) ?k (papp ?t2 ?r2)))

(rule dsubst.u () (dsubst (u ?l) ?k ?r (u ?l)))
(rule dsubst.v () (dsubst (v ?n) ?k ?r (v ?n)))
(rule dsubst.nat () (dsubst nat ?k ?r nat))
(rule dsubst.zero () (dsubst zero ?k ?r zero))
(rule dsubst.pi ((dsubst ?a ?k ?r ?a2) (dsubst ?b ?k ?r ?b2)) (dsubst (pi ?a ?b) ?k ?r (pi ?a2 ?b2)))
(rule dsubst.lam ((dsubst ?t ?k ?r ?t2)) (dsubst (lam ?t) ?k ?r (lam ?t2)))
(rule dsubst.app ((dsubst ?f ?k ?r ?f2) (dsubst ?t ?k ?r ?t2)) (dsubst (app ?f ?t) ?k ?r (app ?f2 ?t2)))
(rule dsubst.path ((ishift ?r z ?r2) (dsubst ?a (s ?k) ?r2 ?a2) (dsubst ?b ?k ?r ?b2) (dsubst ?c ?k ?r ?c2))
  (dsubst (path ?a ?b ?c) ?k ?r (path ?a2 ?b2 ?c2)))
(rule dsubst.plam ((ishift ?r z ?r2) (dsubst ?t (s ?k) ?r2 ?t2))
  (dsubst (plam ?t) ?k ?r (plam ?t2)))
(rule dsubst.papp ((dsubst ?t ?k ?r ?t2) (isubst ?s ?k ?r ?s2))
  (dsubst (papp ?t ?s) ?k ?r (papp ?t2 ?s2)))

(rule dshiftctx.nil () (dshiftctx nil ?k nil))
(rule dshiftctx.cons ((dshiftctx ?g ?k ?g2) (dshift ?a ?k ?a2))
  (dshiftctx (cons ?a ?g) ?k (cons ?a2 ?g2)))

(rule type.path ((ctx ?d ?g) (dshiftctx ?g z ?g2) (has (s ?d) ?g2 ?a (u ?l))
    (dsubst ?a z i0 ?a0) (dsubst ?a z i1 ?a1) (has ?d ?g ?b ?a0) (has ?d ?g ?c ?a1))
  (has ?d ?g (path ?a ?b ?c) (u ?l)))
(rule type.plam ((ctx ?d ?g) (dshiftctx ?g z ?g2) (has (s ?d) ?g2 ?a (u ?l))
    (has (s ?d) ?g2 ?t ?a) (dsubst ?a z i0 ?a0) (dsubst ?a z i1 ?a1)
    (dsubst ?t z i0 ?t0) (dsubst ?t z i1 ?t1) (has ?d ?g ?t0 ?a0) (has ?d ?g ?t1 ?a1))
  (has ?d ?g (plam ?t) (path ?a ?t0 ?t1)))
(rule type.papp ((has ?d ?g ?p (path ?a ?b ?c)) (interval ?d ?r)
    (dsubst ?a z ?r ?ar) (has ?d ?g ?ar (u ?l)))
  (has ?d ?g (papp ?p ?r) ?ar))
(rule eq.pbeta ((has ?d ?g (plam ?t) (path ?a ?b ?c)) (interval ?d ?r)
    (dsubst ?a z ?r ?ar) (dsubst ?t z ?r ?tr) (has ?d ?g ?tr ?ar))
  (eq ?d ?g (papp (plam ?t) ?r) ?tr ?ar))
(rule eq.p0 ((has ?d ?g ?p (path ?a ?b ?c)) (dsubst ?a z i0 ?a0) (has ?d ?g ?b ?a0))
  (eq ?d ?g (papp ?p i0) ?b ?a0))
(rule eq.p1 ((has ?d ?g ?p (path ?a ?b ?c)) (dsubst ?a z i1 ?a1) (has ?d ?g ?c ?a1))
  (eq ?d ?g (papp ?p i1) ?c ?a1))
; Restricted congruence: both substituted family types must be syntactically identical.
(rule eq.pdim ((has ?d ?g ?p (path ?a ?b ?c)) (interval ?d ?r) (interval ?d ?s)
    (ieq ?r ?s) (dsubst ?a z ?r ?ar) (dsubst ?a z ?s ?ar) (has ?d ?g ?ar (u ?l)))
  (eq ?d ?g (papp ?p ?r) (papp ?p ?s) ?ar))
(rule eq.path ((has ?d ?g (path ?a ?b ?c) (u ?l)) (has ?d ?g (path ?a ?b2 ?c2) (u ?l))
    (dsubst ?a z i0 ?a0) (dsubst ?a z i1 ?a1) (eq ?d ?g ?b ?b2 ?a0) (eq ?d ?g ?c ?c2 ?a1))
  (eq ?d ?g (path ?a ?b ?c) (path ?a ?b2 ?c2) (u ?l)))
