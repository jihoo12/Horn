; Ordinary judgmental congruence in the deep object theory. Append after sigma.
; Every dependent result type and every endpoint is explicitly rechecked.
(rule req.pi-cong ((rhas ?d ?g ?phi (pi ?a ?b) (u ?l))
    (rhas ?d ?g ?phi (pi ?a2 ?b2) (u ?l))
    (req ?d ?g ?phi ?a ?a2 (u ?i))
    (req ?d (cons ?a ?g) ?phi ?b ?b2 (u ?j)))
  (req ?d ?g ?phi (pi ?a ?b) (pi ?a2 ?b2) (u ?l)))
(rule req.sigma-cong ((rhas ?d ?g ?phi (sigma ?a ?b) (u ?l))
    (rhas ?d ?g ?phi (sigma ?a2 ?b2) (u ?l))
    (req ?d ?g ?phi ?a ?a2 (u ?i))
    (req ?d (cons ?a ?g) ?phi ?b ?b2 (u ?j)))
  (req ?d ?g ?phi (sigma ?a ?b) (sigma ?a2 ?b2) (u ?l)))
(rule req.lam-cong ((rhas ?d ?g ?phi (lam ?t) (pi ?a ?b))
    (rhas ?d ?g ?phi (lam ?u) (pi ?a ?b))
    (req ?d (cons ?a ?g) ?phi ?t ?u ?b))
  (req ?d ?g ?phi (lam ?t) (lam ?u) (pi ?a ?b)))
(rule req.app-cong ((req ?d ?g ?phi ?f ?f2 (pi ?a ?b))
    (req ?d ?g ?phi ?t ?t2 ?a) (subst ?b z ?t ?bt)
    (rhas ?d ?g ?phi (app ?f ?t) ?bt) (rhas ?d ?g ?phi (app ?f2 ?t2) ?bt))
  (req ?d ?g ?phi (app ?f ?t) (app ?f2 ?t2) ?bt))
(rule req.pair-cong ((rhas ?d ?g ?phi (pair ?t ?u) (sigma ?a ?b))
    (rhas ?d ?g ?phi (pair ?t2 ?u2) (sigma ?a ?b))
    (req ?d ?g ?phi ?t ?t2 ?a) (subst ?b z ?t ?bt)
    (req ?d ?g ?phi ?u ?u2 ?bt))
  (req ?d ?g ?phi (pair ?t ?u) (pair ?t2 ?u2) (sigma ?a ?b)))
(rule req.fst-cong ((req ?d ?g ?phi ?t ?u (sigma ?a ?b))
    (rhas ?d ?g ?phi (fst ?t) ?a) (rhas ?d ?g ?phi (fst ?u) ?a))
  (req ?d ?g ?phi (fst ?t) (fst ?u) ?a))
(rule req.snd-cong ((req ?d ?g ?phi ?t ?u (sigma ?a ?b))
    (subst ?b z (fst ?t) ?bt)
    (rhas ?d ?g ?phi (snd ?t) ?bt) (rhas ?d ?g ?phi (snd ?u) ?bt))
  (req ?d ?g ?phi (snd ?t) (snd ?u) ?bt))
(rule req.path-cong ((rhas ?d ?g ?phi (path ?a ?b ?c) (u ?l))
    (rhas ?d ?g ?phi (path ?a2 ?b2 ?c2) (u ?l))
    (dshiftctx ?g z ?g2) (fshift ?phi z ?phi2)
    (req (s ?d) ?g2 ?phi2 ?a ?a2 (u ?l))
    (dsubst ?a z i0 ?a0) (dsubst ?a z i1 ?a1)
    (req ?d ?g ?phi ?b ?b2 ?a0) (req ?d ?g ?phi ?c ?c2 ?a1))
  (req ?d ?g ?phi (path ?a ?b ?c) (path ?a2 ?b2 ?c2) (u ?l)))
(rule req.plam-cong ((rhas ?d ?g ?phi (plam ?t) (path ?a ?b ?c))
    (rhas ?d ?g ?phi (plam ?u) (path ?a ?b ?c))
    (dshiftctx ?g z ?g2) (fshift ?phi z ?phi2)
    (req (s ?d) ?g2 ?phi2 ?t ?u ?a))
  (req ?d ?g ?phi (plam ?t) (plam ?u) (path ?a ?b ?c)))
(rule req.papp-cong ((req ?d ?g ?phi ?p ?q (path ?a ?b ?c))
    (local ?d ?phi ?r ?s) (dsubst ?a z ?r ?ar)
    (rhas ?d ?g ?phi (papp ?p ?r) ?ar) (rhas ?d ?g ?phi (papp ?q ?s) ?ar))
  (req ?d ?g ?phi (papp ?p ?r) (papp ?q ?s) ?ar))
; Checked abstraction with judgmentally equal (not syntactically identical)
; endpoints. This packages abstraction + Path type congruence + conversion.
(rule rhas.plam-checked ((rhas ?d ?g ?phi (path ?a ?b ?c) (u ?l))
    (dshiftctx ?g z ?g2) (fshift ?phi z ?phi2)
    (rhas (s ?d) ?g2 ?phi2 ?t ?a)
    (dsubst ?t z i0 ?t0) (dsubst ?t z i1 ?t1)
    (dsubst ?a z i0 ?a0) (dsubst ?a z i1 ?a1)
    (req ?d ?g ?phi ?t0 ?b ?a0) (req ?d ?g ?phi ?t1 ?c ?a1))
  (rhas ?d ?g ?phi (plam ?t) (path ?a ?b ?c)))
(rule req.path-eta ((rhas ?d ?g ?phi ?p (path ?a ?b ?c))
    (dshift ?p z ?p2)
    (rhas ?d ?g ?phi (plam (papp ?p2 (dim z))) (path ?a ?b ?c)))
  (req ?d ?g ?phi (plam (papp ?p2 (dim z))) ?p (path ?a ?b ?c)))
; Composition congruence, with the same tube face. In particular, two tubes
; on the empty face must still carry a scoped typed equality under false.
(rule req.comp-cong ((rhas ?d ?g ?psi (comp ?a ?phi ?t ?b) ?out)
    (rhas ?d ?g ?psi (comp ?a2 ?phi ?t2 ?b2) ?out)
    (dshiftctx ?g z ?g2) (fshift ?psi z ?psi2) (fshift ?phi z ?phi2)
    (req (s ?d) ?g2 ?psi2 ?a ?a2 (u ?l))
    (req (s ?d) ?g2 (fand ?psi2 ?phi2) ?t ?t2 ?a)
    (dsubst ?a z i0 ?a0) (req ?d ?g ?psi ?b ?b2 ?a0))
  (req ?d ?g ?psi (comp ?a ?phi ?t ?b) (comp ?a2 ?phi ?t2 ?b2) ?out))

; Composition over equivalent extents. Both typed compositions, mutual
; coverage under the ambient face, and typed tube equality are mandatory.
(rule req.comp-face-cong (
    (rhas ?d ?g ?psi (comp ?a ?phi ?t ?b) ?out)
    (rhas ?d ?g ?psi (comp ?a2 ?chi ?t2 ?b2) ?out)
    (entails ?d (fand ?psi ?phi) ?chi)
    (entails ?d (fand ?psi ?chi) ?phi)
    (dshiftctx ?g z ?g2) (fshift ?psi z ?psi2) (fshift ?phi z ?phi2)
    (req (s ?d) ?g2 ?psi2 ?a ?a2 (u ?l))
    (req (s ?d) ?g2 (fand ?psi2 ?phi2) ?t ?t2 ?a)
    (dsubst ?a z i0 ?a0) (req ?d ?g ?psi ?b ?b2 ?a0))
  (req ?d ?g ?psi (comp ?a ?phi ?t ?b) (comp ?a2 ?chi ?t2 ?b2) ?out))

(rule req.glue-cong (
    (rhas ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u ?v) (glue-type ?a ?phi ?t ?e))
    (rhas ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u2 ?v2) (glue-type ?a ?phi ?t ?e))
    (req ?d ?g (fand ?psi ?phi) ?u ?u2 ?t)
    (req ?d ?g ?psi ?v ?v2 ?a))
  (req ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u ?v)
    (glue (glue-type ?a ?phi ?t ?e) ?u2 ?v2) (glue-type ?a ?phi ?t ?e)))
;; Glue type congruence over equivalent extents. Both Glue types are typed,
;; the extents cover each other under the ambient face, and the partial types
;; and equivalences need only agree where the Glue attaches them.
(rule req.glue-type-cong (
    (rhas ?d ?g ?psi (glue-type ?a ?phi ?t ?e) (u ?l))
    (rhas ?d ?g ?psi (glue-type ?a2 ?phi2 ?t2 ?e2) (u ?l))
    (req ?d ?g ?psi ?a ?a2 (u ?l))
    (entails ?d (fand ?psi ?phi) ?phi2)
    (entails ?d (fand ?psi ?phi2) ?phi)
    (req ?d ?g (fand ?psi ?phi) ?t ?t2 (u ?l))
    (equivdef ?t ?a ?et)
    (req ?d ?g (fand ?psi ?phi) ?e ?e2 ?et))
  (req ?d ?g ?psi (glue-type ?a ?phi ?t ?e) (glue-type ?a2 ?phi2 ?t2 ?e2) (u ?l)))
(rule req.unglue-cong (
    (req ?d ?g ?psi ?b ?b2 (glue-type ?a ?phi ?t ?e))
    (rhas ?d ?g ?psi (unglue ?b) ?a) (rhas ?d ?g ?psi (unglue ?b2) ?a))
  (req ?d ?g ?psi (unglue ?b) (unglue ?b2) ?a))

; Function eta with an explicit ordinary lift and checked reconstruction.
(rule req.fun-eta ((rhas ?d ?g ?psi ?f (pi ?a ?b))
    (shift ?f z ?f2)
    (rhas ?d ?g ?psi (lam (app ?f2 (v z))) (pi ?a ?b)))
  (req ?d ?g ?psi (lam (app ?f2 (v z))) ?f (pi ?a ?b)))
