; Deep syntax extension: append to path + faces + face-ops.
; All conversion, scope, and endpoint obligations are explicit certificates.
(pred length (Ctx N))
(pred scoped (N N Tm))
(pred rctx (N Ctx F))
(pred rhas (N Ctx F Tm Tm))
(rule length.nil () (length nil z))
(rule length.cons ((length ?g ?n)) (length (cons ?a ?g) (s ?n)))
(rule scope.u () (scoped ?d ?n (u ?l)))
(rule scope.nat () (scoped ?d ?n nat))
(rule scope.zero () (scoped ?d ?n zero))
(rule scope.v ((lt ?k ?n)) (scoped ?d ?n (v ?k)))
(rule scope.pi ((scoped ?d ?n ?a) (scoped ?d (s ?n) ?b)) (scoped ?d ?n (pi ?a ?b)))
(rule scope.lam ((scoped ?d (s ?n) ?t)) (scoped ?d ?n (lam ?t)))
(rule scope.app ((scoped ?d ?n ?f) (scoped ?d ?n ?t)) (scoped ?d ?n (app ?f ?t)))
(rule scope.path ((scoped (s ?d) ?n ?a) (scoped ?d ?n ?b) (scoped ?d ?n ?c))
  (scoped ?d ?n (path ?a ?b ?c)))
(rule scope.plam ((scoped (s ?d) ?n ?t)) (scoped ?d ?n (plam ?t)))
(rule scope.papp ((scoped ?d ?n ?p) (interval ?d ?r)) (scoped ?d ?n (papp ?p ?r)))

(rule rctx.nil ((face ?d ?phi)) (rctx ?d nil ?phi))
(rule rctx.cons ((rctx ?d ?g ?phi) (rhas ?d ?g ?phi ?a (u ?l)))
  (rctx ?d (cons ?a ?g) ?phi))
(rule rctx.global ((face ?d ?phi) (ctx ?d ?g)) (rctx ?d ?g ?phi))
(rule rctx.weaken ((entails ?d ?phi ?psi) (rctx ?d ?g ?psi)) (rctx ?d ?g ?phi))
(rule rctx.export ((rctx ?d ?g ft)) (ctx ?d ?g))

(rule rhas.global ((face ?d ?phi) (has ?d ?g ?t ?a)) (rhas ?d ?g ?phi ?t ?a))
(rule rhas.weaken ((entails ?d ?phi ?psi) (rhas ?d ?g ?psi ?t ?a))
  (rhas ?d ?g ?phi ?t ?a))
(rule rhas.export ((rhas ?d ?g ft ?t ?a)) (has ?d ?g ?t ?a))
(rule req.export ((req ?d ?g ft ?t ?s ?a)) (eq ?d ?g ?t ?s ?a))
(rule rhas.u ((rctx ?d ?g ?phi)) (rhas ?d ?g ?phi (u ?l) (u (s ?l))))
(rule rhas.nat ((rctx ?d ?g ?phi)) (rhas ?d ?g ?phi nat (u z)))
(rule rhas.zero ((rctx ?d ?g ?phi)) (rhas ?d ?g ?phi zero nat))
(rule rhas.v ((rctx ?d ?g ?phi) (lookup ?g ?n ?a)) (rhas ?d ?g ?phi (v ?n) ?a))
(rule rhas.pi ((rhas ?d ?g ?phi ?a (u ?i))
    (rhas ?d (cons ?a ?g) ?phi ?b (u ?j)) (max ?i ?j ?k))
  (rhas ?d ?g ?phi (pi ?a ?b) (u ?k)))
(rule rhas.lam ((rhas ?d ?g ?phi ?a (u ?i))
    (rhas ?d (cons ?a ?g) ?phi ?t ?b) (rhas ?d (cons ?a ?g) ?phi ?b (u ?j)))
  (rhas ?d ?g ?phi (lam ?t) (pi ?a ?b)))
(rule rhas.app ((rhas ?d ?g ?phi ?f (pi ?a ?b)) (rhas ?d ?g ?phi ?t ?a)
    (subst ?b z ?t ?c) (rhas ?d ?g ?phi ?c (u ?l)))
  (rhas ?d ?g ?phi (app ?f ?t) ?c))
(rule rhas.conv ((rhas ?d ?g ?phi ?t ?a) (req ?d ?g ?phi ?a ?b (u ?l))
    (rhas ?d ?g ?phi ?b (u ?l))) (rhas ?d ?g ?phi ?t ?b))
; False elimination still checks every free variable and dimension of t.
(rule rhas.false ((rctx ?d ?g ?phi) (length ?g ?n) (scoped ?d ?n ?t)
    (rhas ?d ?g ?phi ?a (u ?l)) (entails ?d ?phi ff)) (rhas ?d ?g ?phi ?t ?a))

(rule rhas.path ((rctx ?d ?g ?phi) (dshiftctx ?g z ?g2) (fshift ?phi z ?phi2)
    (rhas (s ?d) ?g2 ?phi2 ?a (u ?l))
    (dsubst ?a z i0 ?a0) (dsubst ?a z i1 ?a1)
    (rhas ?d ?g ?phi ?a0 (u ?l)) (rhas ?d ?g ?phi ?a1 (u ?l))
    (rhas ?d ?g ?phi ?b ?a0) (rhas ?d ?g ?phi ?c ?a1))
  (rhas ?d ?g ?phi (path ?a ?b ?c) (u ?l)))
(rule rhas.plam ((rctx ?d ?g ?phi) (dshiftctx ?g z ?g2) (fshift ?phi z ?phi2)
    (rhas (s ?d) ?g2 ?phi2 ?a (u ?l)) (rhas (s ?d) ?g2 ?phi2 ?t ?a)
    (dsubst ?a z i0 ?a0) (dsubst ?a z i1 ?a1)
    (dsubst ?t z i0 ?t0) (dsubst ?t z i1 ?t1)
    (rhas ?d ?g ?phi ?a0 (u ?l)) (rhas ?d ?g ?phi ?a1 (u ?l))
    (rhas ?d ?g ?phi ?t0 ?a0) (rhas ?d ?g ?phi ?t1 ?a1))
  (rhas ?d ?g ?phi (plam ?t) (path ?a ?t0 ?t1)))
(rule rhas.papp ((rhas ?d ?g ?phi ?p (path ?a ?b ?c)) (interval ?d ?r)
    (dsubst ?a z ?r ?ar) (rhas ?d ?g ?phi ?ar (u ?l)))
  (rhas ?d ?g ?phi (papp ?p ?r) ?ar))

(rule req.refl ((rhas ?d ?g ?phi ?t ?a)) (req ?d ?g ?phi ?t ?t ?a))
(rule req.weaken ((entails ?d ?phi ?psi) (req ?d ?g ?psi ?t ?s ?a))
  (req ?d ?g ?phi ?t ?s ?a))
(rule req.false ((entails ?d ?phi ff) (rhas ?d ?g ?phi ?t ?a) (rhas ?d ?g ?phi ?s ?a))
  (req ?d ?g ?phi ?t ?s ?a))
(rule req.conv ((req ?d ?g ?phi ?t ?s ?a) (req ?d ?g ?phi ?a ?b (u ?l))
    (rhas ?d ?g ?phi ?b (u ?l))) (req ?d ?g ?phi ?t ?s ?b))
(rule req.cases ((entails ?d ?phi (for ?a ?b))
    (req ?d ?g ?a ?t ?s ?ty) (req ?d ?g ?b ?t ?s ?ty)) (req ?d ?g ?phi ?t ?s ?ty))
(rule req.pdim-r ((rhas ?d ?g ?phi ?p (path ?a ?b ?c)) (local ?d ?phi ?r ?s)
    (dsubst ?a z ?r ?ar) (dsubst ?a z ?s ?ar) (rhas ?d ?g ?phi ?ar (u ?l)))
  (req ?d ?g ?phi (papp ?p ?r) (papp ?p ?s) ?ar))
(rule req.p0-r ((rhas ?d ?g ?phi ?p (path ?a ?b ?c)) (dsubst ?a z i0 ?a0)
    (rhas ?d ?g ?phi ?a0 (u ?l)) (rhas ?d ?g ?phi ?b ?a0))
  (req ?d ?g ?phi (papp ?p i0) ?b ?a0))
(rule req.p1-r ((rhas ?d ?g ?phi ?p (path ?a ?b ?c)) (dsubst ?a z i1 ?a1)
    (rhas ?d ?g ?phi ?a1 (u ?l)) (rhas ?d ?g ?phi ?c ?a1))
  (req ?d ?g ?phi (papp ?p i1) ?c ?a1))
(rule req.pbeta-r ((rhas ?d ?g ?phi (plam ?t) (path ?a ?b ?c)) (interval ?d ?r)
    (dsubst ?a z ?r ?ar) (dsubst ?t z ?r ?tr) (rhas ?d ?g ?phi ?tr ?ar))
  (req ?d ?g ?phi (papp (plam ?t) ?r) ?tr ?ar))
(rule req.beta-r ((rhas ?d ?g ?phi ?a (u ?i))
    (rhas ?d (cons ?a ?g) ?phi ?t ?b) (rhas ?d (cons ?a ?g) ?phi ?b (u ?j))
    (rhas ?d ?g ?phi ?r ?a) (subst ?t z ?r ?out) (subst ?b z ?r ?c)
    (rhas ?d ?g ?phi ?out ?c))
  (req ?d ?g ?phi (app (lam ?t) ?r) ?out ?c))

; Explicit, checked type annotation for otherwise erased introductions.
; It is an object term: its type AND its payload are checked.
(ctor ann (Tm Tm) Tm)
(rule scope.ann ((scoped ?d ?n ?t) (scoped ?d ?n ?a)) (scoped ?d ?n (ann ?t ?a)))
(rule shift.ann ((shift ?t ?k ?t2) (shift ?a ?k ?a2)) (shift (ann ?t ?a) ?k (ann ?t2 ?a2)))
(rule subst.ann ((subst ?t ?k ?r ?t2) (subst ?a ?k ?r ?a2)) (subst (ann ?t ?a) ?k ?r (ann ?t2 ?a2)))
(rule dshift.ann ((dshift ?t ?k ?t2) (dshift ?a ?k ?a2)) (dshift (ann ?t ?a) ?k (ann ?t2 ?a2)))
(rule dsubst.ann ((dsubst ?t ?k ?r ?t2) (dsubst ?a ?k ?r ?a2)) (dsubst (ann ?t ?a) ?k ?r (ann ?t2 ?a2)))
(rule rhas.ann ((rhas ?d ?g ?phi ?a (u ?l)) (rhas ?d ?g ?phi ?t ?a))
  (rhas ?d ?g ?phi (ann ?t ?a) ?a))
(rule req.ann ((rhas ?d ?g ?phi (ann ?t ?a) ?a) (rhas ?d ?g ?phi ?t ?a))
  (req ?d ?g ?phi (ann ?t ?a) ?t ?a))

; Ordinary context extension (structural weakening). The inserted type is
; itself checked in the source context; both term and type lifts are certified.
(rule rhas.shift ((rhas ?d ?g ?phi ?t ?a)
    (rhas ?d ?g ?phi ?b (u ?l)) (shift ?t z ?t2) (shift ?a z ?a2))
  (rhas ?d (cons ?b ?g) ?phi ?t2 ?a2))

; Ordinary beta subject reduction. The WHOLE application must already be
; typed, and capture-avoiding substitution is a separate checked derivation.
; This structural rule does not contain any cubical or univalence principle.
(rule rhas.beta ((rhas ?d ?g ?phi (app (lam ?body) ?arg) ?a)
    (subst ?body z ?arg ?out))
  (rhas ?d ?g ?phi ?out ?a))
(rule req.beta-typed ((rhas ?d ?g ?phi (app (lam ?body) ?arg) ?a)
    (subst ?body z ?arg ?out) (rhas ?d ?g ?phi ?out ?a))
  (req ?d ?g ?phi (app (lam ?body) ?arg) ?out ?a))
