; Dependent sums in the SAME deep syntax, appended after restricted.horn.
(ctor sigma (Tm Tm) Tm)
(ctor pair (Tm Tm) Tm)
(ctor fst (Tm) Tm)
(ctor snd (Tm) Tm)
(rule scope.sigma ((scoped ?d ?n ?a) (scoped ?d (s ?n) ?b)) (scoped ?d ?n (sigma ?a ?b)))
(rule scope.pair ((scoped ?d ?n ?t) (scoped ?d ?n ?u)) (scoped ?d ?n (pair ?t ?u)))
(rule scope.fst ((scoped ?d ?n ?t)) (scoped ?d ?n (fst ?t)))
(rule scope.snd ((scoped ?d ?n ?t)) (scoped ?d ?n (snd ?t)))
(rule shift.sigma ((shift ?a ?k ?a2) (shift ?b (s ?k) ?b2)) (shift (sigma ?a ?b) ?k (sigma ?a2 ?b2)))
(rule subst.sigma ((subst ?a ?k ?r ?a2) (shift ?r z ?r2) (subst ?b (s ?k) ?r2 ?b2))
  (subst (sigma ?a ?b) ?k ?r (sigma ?a2 ?b2)))
(rule dshift.sigma ((dshift ?a ?k ?a2) (dshift ?b ?k ?b2)) (dshift (sigma ?a ?b) ?k (sigma ?a2 ?b2)))
(rule dsubst.sigma ((dsubst ?a ?k ?r ?a2) (dsubst ?b ?k ?r ?b2)) (dsubst (sigma ?a ?b) ?k ?r (sigma ?a2 ?b2)))
(rule shift.pair ((shift ?a ?k ?a2) (shift ?b ?k ?b2)) (shift (pair ?a ?b) ?k (pair ?a2 ?b2)))
(rule subst.pair ((subst ?a ?k ?r ?a2) (subst ?b ?k ?r ?b2)) (subst (pair ?a ?b) ?k ?r (pair ?a2 ?b2)))
(rule dshift.pair ((dshift ?a ?k ?a2) (dshift ?b ?k ?b2)) (dshift (pair ?a ?b) ?k (pair ?a2 ?b2)))
(rule dsubst.pair ((dsubst ?a ?k ?r ?a2) (dsubst ?b ?k ?r ?b2)) (dsubst (pair ?a ?b) ?k ?r (pair ?a2 ?b2)))
(rule shift.fst ((shift ?t ?k ?t2)) (shift (fst ?t) ?k (fst ?t2)))
(rule subst.fst ((subst ?t ?k ?r ?t2)) (subst (fst ?t) ?k ?r (fst ?t2)))
(rule dshift.fst ((dshift ?t ?k ?t2)) (dshift (fst ?t) ?k (fst ?t2)))
(rule dsubst.fst ((dsubst ?t ?k ?r ?t2)) (dsubst (fst ?t) ?k ?r (fst ?t2)))
(rule shift.snd ((shift ?t ?k ?t2)) (shift (snd ?t) ?k (snd ?t2)))
(rule subst.snd ((subst ?t ?k ?r ?t2)) (subst (snd ?t) ?k ?r (snd ?t2)))
(rule dshift.snd ((dshift ?t ?k ?t2)) (dshift (snd ?t) ?k (snd ?t2)))
(rule dsubst.snd ((dsubst ?t ?k ?r ?t2)) (dsubst (snd ?t) ?k ?r (snd ?t2)))
(rule rhas.sigma ((rhas ?d ?g ?phi ?a (u ?i)) (rhas ?d (cons ?a ?g) ?phi ?b (u ?j))
    (max ?i ?j ?k)) (rhas ?d ?g ?phi (sigma ?a ?b) (u ?k)))
(rule rhas.pair ((rhas ?d ?g ?phi ?a (u ?i)) (rhas ?d (cons ?a ?g) ?phi ?b (u ?j))
    (rhas ?d ?g ?phi ?t ?a) (subst ?b z ?t ?bt) (rhas ?d ?g ?phi ?bt (u ?j))
    (rhas ?d ?g ?phi ?u ?bt)) (rhas ?d ?g ?phi (pair ?t ?u) (sigma ?a ?b)))
(rule rhas.fst ((rhas ?d ?g ?phi ?t (sigma ?a ?b)) (rhas ?d ?g ?phi ?a (u ?l)))
  (rhas ?d ?g ?phi (fst ?t) ?a))
(rule rhas.snd ((rhas ?d ?g ?phi ?t (sigma ?a ?b)) (subst ?b z (fst ?t) ?bt)
    (rhas ?d ?g ?phi ?bt (u ?l))) (rhas ?d ?g ?phi (snd ?t) ?bt))
(rule req.fst-beta ((rhas ?d ?g ?phi (pair ?t ?u) (sigma ?a ?b)) (rhas ?d ?g ?phi ?t ?a))
  (req ?d ?g ?phi (fst (pair ?t ?u)) ?t ?a))
(rule req.snd-beta ((rhas ?d ?g ?phi (pair ?t ?u) (sigma ?a ?b))
    (subst ?b z (fst (pair ?t ?u)) ?bt) (rhas ?d ?g ?phi ?u ?bt))
  (req ?d ?g ?phi (snd (pair ?t ?u)) ?u ?bt))
(rule req.pair-eta ((rhas ?d ?g ?phi ?t (sigma ?a ?b))
    (rhas ?d ?g ?phi (pair (fst ?t) (snd ?t)) (sigma ?a ?b)))
  (req ?d ?g ?phi (pair (fst ?t) (snd ?t)) ?t (sigma ?a ?b)))
