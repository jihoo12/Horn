; Append after restricted.horn. Every pair of branches must agree on overlap.
(sort Sys)
(ctor snil () Sys)
(ctor side (F Tm Sys) Sys)
(ctor system (Sys) Tm)
(pred sscoped (N N Sys))
(pred coherent (N Ctx F Sys Tm F))
(pred overlaps (N Ctx F F Tm Sys Tm))
(pred branch (Sys F Tm))
(pred agrees (N Ctx F Sys Tm Tm))
(pred sshift (Sys N Sys))
(pred ssubst (Sys N Tm Sys))
(pred sdshift (Sys N Sys))
(pred sdsubst (Sys N I Sys))
(rule sscope.nil () (sscoped ?d ?n snil))
(rule sscope.side ((face ?d ?phi) (scoped ?d ?n ?t) (sscoped ?d ?n ?s))
  (sscoped ?d ?n (side ?phi ?t ?s)))
(rule scope.system ((sscoped ?d ?n ?s)) (scoped ?d ?n (system ?s)))
(rule sshift.nil () (sshift snil ?k snil))
(rule sshift.side ((shift ?t ?k ?t2) (sshift ?s ?k ?s2))
  (sshift (side ?phi ?t ?s) ?k (side ?phi ?t2 ?s2)))
(rule ssubst.nil () (ssubst snil ?k ?r snil))
(rule ssubst.side ((subst ?t ?k ?r ?t2) (ssubst ?s ?k ?r ?s2))
  (ssubst (side ?phi ?t ?s) ?k ?r (side ?phi ?t2 ?s2)))
(rule sdshift.nil () (sdshift snil ?k snil))
(rule sdshift.side ((fshift ?phi ?k ?phi2) (dshift ?t ?k ?t2) (sdshift ?s ?k ?s2))
  (sdshift (side ?phi ?t ?s) ?k (side ?phi2 ?t2 ?s2)))
(rule sdsubst.nil () (sdsubst snil ?k ?r snil))
(rule sdsubst.side ((fsubst ?phi ?k ?r ?phi2) (dsubst ?t ?k ?r ?t2) (sdsubst ?s ?k ?r ?s2))
  (sdsubst (side ?phi ?t ?s) ?k ?r (side ?phi2 ?t2 ?s2)))
(rule shift.system ((sshift ?s ?k ?s2)) (shift (system ?s) ?k (system ?s2)))
(rule subst.system ((ssubst ?s ?k ?r ?s2)) (subst (system ?s) ?k ?r (system ?s2)))
(rule dshift.system ((sdshift ?s ?k ?s2)) (dshift (system ?s) ?k (system ?s2)))
(rule dsubst.system ((sdsubst ?s ?k ?r ?s2)) (dsubst (system ?s) ?k ?r (system ?s2)))

(rule overlaps.nil () (overlaps ?d ?g ?base ?phi ?t snil ?a))
(rule overlaps.side ((req ?d ?g (fand (fand ?base ?phi) ?psi) ?t ?u ?a)
    (overlaps ?d ?g ?base ?phi ?t ?rest ?a))
  (overlaps ?d ?g ?base ?phi ?t (side ?psi ?u ?rest) ?a))
(rule coherent.nil ((rctx ?d ?g ?base)) (coherent ?d ?g ?base snil ?a ff))
(rule coherent.side ((face ?d ?phi) (rhas ?d ?g (fand ?base ?phi) ?t ?a)
    (coherent ?d ?g ?base ?rest ?a ?dom) (overlaps ?d ?g ?base ?phi ?t ?rest ?a))
  (coherent ?d ?g ?base (side ?phi ?t ?rest) ?a (for ?phi ?dom)))
(rule rhas.system ((rhas ?d ?g ?base ?a (u ?l)) (coherent ?d ?g ?base ?s ?a ?dom)
    (entails ?d ?base ?dom)) (rhas ?d ?g ?base (system ?s) ?a))
(rule branch.here () (branch (side ?phi ?t ?rest) ?phi ?t))
(rule branch.there ((branch ?rest ?phi ?t)) (branch (side ?psi ?u ?rest) ?phi ?t))
(rule req.system-branch ((rhas ?d ?g ?base (system ?s) ?a) (branch ?s ?phi ?t)
    (entails ?d ?base ?phi) (rhas ?d ?g ?base ?t ?a))
  (req ?d ?g ?base (system ?s) ?t ?a))
(rule agrees.nil () (agrees ?d ?g ?base snil ?t ?a))
(rule agrees.side ((req ?d ?g (fand ?base ?phi) ?u ?t ?a)
    (agrees ?d ?g ?base ?rest ?t ?a))
  (agrees ?d ?g ?base (side ?phi ?u ?rest) ?t ?a))
(rule req.system-eq ((rhas ?d ?g ?base (system ?s) ?a) (rhas ?d ?g ?base ?t ?a)
    (agrees ?d ?g ?base ?s ?t ?a)) (req ?d ?g ?base (system ?s) ?t ?a))
