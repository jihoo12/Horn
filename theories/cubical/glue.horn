; Deep Glue primitives, appended after sigma and equivalence-defs.
; This is a declarative OBJECT THEORY extension, not a new kernel algorithm.
; There is no ua or univalence rule here. Type-directed Glue composition is
; deliberately still absent, so this is not yet computational univalence.
(ctor glue-type (Tm F Tm Tm) Tm)
(ctor glue (Tm Tm Tm) Tm)
(ctor unglue (Tm) Tm)
(rule scope.glue-type ((scoped ?d ?n ?a) (face ?d ?phi) (scoped ?d ?n ?t) (scoped ?d ?n ?e))
  (scoped ?d ?n (glue-type ?a ?phi ?t ?e)))
(rule scope.glue ((scoped ?d ?n ?g) (scoped ?d ?n ?t) (scoped ?d ?n ?a))
  (scoped ?d ?n (glue ?g ?t ?a)))
(rule scope.unglue ((scoped ?d ?n ?t)) (scoped ?d ?n (unglue ?t)))
(rule shift.glue-type ((shift ?a ?k ?a2) (shift ?t ?k ?t2) (shift ?e ?k ?e2))
  (shift (glue-type ?a ?phi ?t ?e) ?k (glue-type ?a2 ?phi ?t2 ?e2)))
(rule subst.glue-type ((subst ?a ?k ?r ?a2) (subst ?t ?k ?r ?t2) (subst ?e ?k ?r ?e2))
  (subst (glue-type ?a ?phi ?t ?e) ?k ?r (glue-type ?a2 ?phi ?t2 ?e2)))
(rule dshift.glue-type ((dshift ?a ?k ?a2) (fshift ?phi ?k ?phi2) (dshift ?t ?k ?t2) (dshift ?e ?k ?e2))
  (dshift (glue-type ?a ?phi ?t ?e) ?k (glue-type ?a2 ?phi2 ?t2 ?e2)))
(rule dsubst.glue-type ((dsubst ?a ?k ?r ?a2) (fsubst ?phi ?k ?r ?phi2)
    (dsubst ?t ?k ?r ?t2) (dsubst ?e ?k ?r ?e2))
  (dsubst (glue-type ?a ?phi ?t ?e) ?k ?r (glue-type ?a2 ?phi2 ?t2 ?e2)))
(rule shift.glue ((shift ?g ?k ?g2) (shift ?t ?k ?t2) (shift ?a ?k ?a2))
  (shift (glue ?g ?t ?a) ?k (glue ?g2 ?t2 ?a2)))
(rule subst.glue ((subst ?g ?k ?r ?g2) (subst ?t ?k ?r ?t2) (subst ?a ?k ?r ?a2))
  (subst (glue ?g ?t ?a) ?k ?r (glue ?g2 ?t2 ?a2)))
(rule dshift.glue ((dshift ?g ?k ?g2) (dshift ?t ?k ?t2) (dshift ?a ?k ?a2))
  (dshift (glue ?g ?t ?a) ?k (glue ?g2 ?t2 ?a2)))
(rule dsubst.glue ((dsubst ?g ?k ?r ?g2) (dsubst ?t ?k ?r ?t2) (dsubst ?a ?k ?r ?a2))
  (dsubst (glue ?g ?t ?a) ?k ?r (glue ?g2 ?t2 ?a2)))
(rule shift.unglue ((shift ?t ?k ?t2)) (shift (unglue ?t) ?k (unglue ?t2)))
(rule subst.unglue ((subst ?t ?k ?r ?t2)) (subst (unglue ?t) ?k ?r (unglue ?t2)))
(rule dshift.unglue ((dshift ?t ?k ?t2)) (dshift (unglue ?t) ?k (unglue ?t2)))
(rule dsubst.unglue ((dsubst ?t ?k ?r ?t2)) (dsubst (unglue ?t) ?k ?r (unglue ?t2)))

(rule rhas.glue-type ((rhas ?d ?g ?psi ?a (u ?l)) (face ?d ?phi)
    (rhas ?d ?g (fand ?psi ?phi) ?t (u ?l)) (equivdef ?t ?a ?et)
    (rhas ?d ?g (fand ?psi ?phi) ?et (u ?l)) (rhas ?d ?g (fand ?psi ?phi) ?e ?et))
  (rhas ?d ?g ?psi (glue-type ?a ?phi ?t ?e) (u ?l)))
(rule req.glue-type ((rhas ?d ?g ?psi (glue-type ?a ?phi ?t ?e) (u ?l))
    (entails ?d ?psi ?phi) (rhas ?d ?g ?psi ?t (u ?l)))
  (req ?d ?g ?psi (glue-type ?a ?phi ?t ?e) ?t (u ?l)))
(rule rhas.glue ((rhas ?d ?g ?psi (glue-type ?a ?phi ?t ?e) (u ?l))
    (rhas ?d ?g (fand ?psi ?phi) ?u ?t) (rhas ?d ?g ?psi ?v ?a)
    (rhas ?d ?g (fand ?psi ?phi) (app (fst ?e) ?u) ?a)
    (req ?d ?g (fand ?psi ?phi) (app (fst ?e) ?u) ?v ?a))
  (rhas ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u ?v) (glue-type ?a ?phi ?t ?e)))
(rule rhas.unglue ((rhas ?d ?g ?psi ?u (glue-type ?a ?phi ?t ?e))
    (rhas ?d ?g ?psi ?a (u ?l))) (rhas ?d ?g ?psi (unglue ?u) ?a))
(rule req.unglue-beta ((rhas ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u ?v) (glue-type ?a ?phi ?t ?e))
    (rhas ?d ?g ?psi ?v ?a))
  (req ?d ?g ?psi (unglue (glue (glue-type ?a ?phi ?t ?e) ?u ?v)) ?v ?a))
(rule req.glue-face ((rhas ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u ?v) (glue-type ?a ?phi ?t ?e))
    (entails ?d ?psi ?phi) (rhas ?d ?g ?psi ?u ?t)
    (rhas ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u ?v) ?t))
  (req ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u ?v) ?u ?t))
(rule req.unglue-face ((rhas ?d ?g ?psi ?u (glue-type ?a ?phi ?t ?e))
    (entails ?d ?psi ?phi) (rhas ?d ?g ?psi (app (fst ?e) ?u) ?a))
  (req ?d ?g ?psi (unglue ?u) (app (fst ?e) ?u) ?a))
(rule req.glue-eta ((rhas ?d ?g ?psi ?u (glue-type ?a ?phi ?t ?e))
    (rhas ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u (unglue ?u)) (glue-type ?a ?phi ?t ?e)))
  (req ?d ?g ?psi (glue (glue-type ?a ?phi ?t ?e) ?u (unglue ?u)) ?u (glue-type ?a ?phi ?t ?e)))
