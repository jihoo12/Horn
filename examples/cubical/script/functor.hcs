; Functors and natural transformations between wild precategories (the
; definitions of category.hcs, repeated: scripts are standalone). The
; functor laws of composites are paths built from the components'; the
; identity functor is a unit for composition on both maps by refl; the
; identity natural transformation is natural by the unit laws, and vertical
; composition by associativity and the two naturality squares.
(def trans (pi {A} (u 0) (pi {x} A (pi {y} A (pi {z} A
             (pi p (path A x y) (pi q (path A y z) (path A x z)))))))
  (lam p (path A x y) (lam q (path A y z)
    (plam i (hcomp j A (((= i 0) x) ((= i 1) (papp q j))) (papp p i))))))
(def ap (pi {A} (u 0) (pi {B} (u 0) (pi {x} A (pi {y} A
          (pi f (pi a A B) (pi p (path A x y) (path B (app f x) (app f y))))))))
  (lam f (pi a A B) (lam p (path A x y) (plam i (app f (papp p i))))))
(def sym (pi {A} (u 0) (pi {x} A (pi {y} A (pi p (path A x y) (path A y x)))))
  (lam p (path A x y) (plam i (papp p (neg i)))))

(def Cat (u 2)
  (sigma Ob (u 1)
  (sigma Hom (pi x Ob (pi y Ob (u 0)))
  (sigma id (pi x Ob (app Hom x x))
  (sigma cmp (pi x Ob (pi y Ob (pi z Ob (pi f (app Hom x y) (pi g (app Hom y z) (app Hom x z))))))
  (sigma idl (pi x Ob (pi y Ob (pi f (app Hom x y) (path (app Hom x y) (app cmp x x y (app id x) f) f))))
  (sigma idr (pi x Ob (pi y Ob (pi f (app Hom x y) (path (app Hom x y) (app cmp x y y f (app id y)) f))))
    (pi w Ob (pi x Ob (pi y Ob (pi z Ob
      (pi f (app Hom w x) (pi g (app Hom x y) (pi h (app Hom y z)
        (path (app Hom w z) (app cmp w x z f (app cmp x y z g h)) (app cmp w y z (app cmp w x y f g) h))))))))))))))))
(def Ob (pi C Cat (u 1)) (lam C Cat (fst C)))
(def Hom (pi C Cat (pi x (app Ob C) (pi y (app Ob C) (u 0)))) (lam C Cat (fst (snd C))))
(def id (pi C Cat (pi x (app Ob C) (app Hom C x x))) (lam C Cat (fst (snd (snd C)))))
(def cmp (pi C Cat (pi x (app Ob C) (pi y (app Ob C) (pi z (app Ob C)
          (pi f (app Hom C x y) (pi g (app Hom C y z) (app Hom C x z)))))))
  (lam C Cat (fst (snd (snd (snd C))))))

; Functors: an object map, a morphism map, and preservation of identities
; and composition.
(def Functor (pi C Cat (pi D Cat (u 1)))
  (lam C Cat (lam D Cat
    (sigma F0 (pi x (app Ob C) (app Ob D))
    (sigma F1 (pi x (app Ob C) (pi y (app Ob C) (pi f (app Hom C x y) (app Hom D (app F0 x) (app F0 y)))))
    (sigma Fid (pi x (app Ob C) (path (app Hom D (app F0 x) (app F0 x)) (app F1 x x (app id C x)) (app id D (app F0 x))))
      (pi x (app Ob C) (pi y (app Ob C) (pi z (app Ob C)
        (pi f (app Hom C x y) (pi g (app Hom C y z)
          (path (app Hom D (app F0 x) (app F0 z))
            (app F1 x z (app cmp C x y z f g))
            (app cmp D (app F0 x) (app F0 y) (app F0 z) (app F1 x y f) (app F1 y z g))))))))))))))
(def fob (pi C Cat (pi D Cat (pi F (app Functor C D) (pi x (app Ob C) (app Ob D)))))
  (lam C Cat (lam D Cat (lam F (app Functor C D) (fst F)))))
(def fhom (pi C Cat (pi D Cat (pi F (app Functor C D)
          (pi x (app Ob C) (pi y (app Ob C) (pi f (app Hom C x y)
            (app Hom D (app fob C D F x) (app fob C D F y))))))))
  (lam C Cat (lam D Cat (lam F (app Functor C D) (fst (snd F))))))

; The identity functor.
(def idF (pi C Cat (app Functor C C))
  (lam C Cat
    (pair (lam x (app Ob C) x)
    (pair (lam x (app Ob C) (lam y (app Ob C) (lam f (app Hom C x y) f)))
    (pair (lam x (app Ob C) (plam i (app id C x)))
      (lam x (app Ob C) (lam y (app Ob C) (lam z (app Ob C)
        (lam f (app Hom C x y) (lam g (app Hom C y z) (plam i (app cmp C x y z f g))))))))))))

; Composite functors: G after F.
(def compF (pi C Cat (pi D Cat (pi E Cat (pi F (app Functor C D) (pi G (app Functor D E) (app Functor C E))))))
  (lam C Cat (lam D Cat (lam E Cat (lam F (app Functor C D) (lam G (app Functor D E)
    (pair (lam x (app Ob C) (app fob D E G (app fob C D F x)))
    (pair (lam x (app Ob C) (lam y (app Ob C) (lam f (app Hom C x y)
            (app fhom D E G (app fob C D F x) (app fob C D F y) (app fhom C D F x y f)))))
    (pair (lam x (app Ob C)
            (app trans
              (app ap (app fhom D E G (app fob C D F x) (app fob C D F x)) (app (fst (snd (snd F))) x))
              (app (fst (snd (snd G))) (app fob C D F x))))
      (lam x (app Ob C) (lam y (app Ob C) (lam z (app Ob C)
        (lam f (app Hom C x y) (lam g (app Hom C y z)
          (app trans
            (app ap (app fhom D E G (app fob C D F x) (app fob C D F z)) (app (snd (snd (snd F))) x y z f g))
            (app (snd (snd (snd G))) (app fob C D F x) (app fob C D F y) (app fob C D F z)
              (app fhom C D F x y f) (app fhom C D F y z g)))))))))))))))))

; Composing with the identity changes neither map.
(check id-after-obj (lam C Cat (lam D Cat (lam F (app Functor C D)
    (plam i (app fob C D F)))))
  (pi C Cat (pi D Cat (pi F (app Functor C D)
    (path (pi x (app Ob C) (app Ob D)) (app fob C D (app compF C C D (app idF C) F)) (app fob C D F))))))
(check after-id-hom (lam C Cat (lam D Cat (lam F (app Functor C D)
    (plam i (app fhom C D F)))))
  (pi C Cat (pi D Cat (pi F (app Functor C D)
    (path (pi x (app Ob C) (pi y (app Ob C) (pi f (app Hom C x y) (app Hom D (app fob C D F x) (app fob C D F y)))))
      (app fhom C D (app compF C D D F (app idF D))) (app fhom C D F))))))

; Natural transformations, and the identity on any functor: naturality is
; the unit laws of the target category.
(def Nat (pi C Cat (pi D Cat (pi F (app Functor C D) (pi G (app Functor C D) (u 1)))))
  (lam C Cat (lam D Cat (lam F (app Functor C D) (lam G (app Functor C D)
    (sigma a (pi x (app Ob C) (app Hom D (app fob C D F x) (app fob C D G x)))
      (pi x (app Ob C) (pi y (app Ob C) (pi f (app Hom C x y)
        (path (app Hom D (app fob C D F x) (app fob C D G y))
          (app cmp D (app fob C D F x) (app fob C D F y) (app fob C D G y) (app fhom C D F x y f) (app a y))
          (app cmp D (app fob C D F x) (app fob C D G x) (app fob C D G y) (app a x) (app fhom C D G x y f))))))))))))
(def idN (pi C Cat (pi D Cat (pi F (app Functor C D) (app Nat C D F F))))
  (lam C Cat (lam D Cat (lam F (app Functor C D)
    (pair (lam x (app Ob C) (app id D (app fob C D F x)))
      (lam x (app Ob C) (lam y (app Ob C) (lam f (app Hom C x y)
        (app trans
          (app (fst (snd (snd (snd (snd (snd D)))))) (app fob C D F x) (app fob C D F y) (app fhom C D F x y f))
          (app sym (app (fst (snd (snd (snd (snd D))))) (app fob C D F x) (app fob C D F y) (app fhom C D F x y f))))))))))))

; Vertical composition: (b after a) at x is a x then b x. Naturality chains
; associativity with the two naturality squares.
(def vcomp (pi C Cat (pi D Cat (pi F (app Functor C D) (pi G (app Functor C D) (pi H (app Functor C D)
          (pi a (app Nat C D F G) (pi b (app Nat C D G H) (app Nat C D F H))))))))
  (lam C Cat (lam D Cat (lam F (app Functor C D) (lam G (app Functor C D) (lam H (app Functor C D)
  (lam a (app Nat C D F G) (lam b (app Nat C D G H)
    (pair (lam x (app Ob C)
            (app cmp D (app fob C D F x) (app fob C D G x) (app fob C D H x) (app (fst a) x) (app (fst b) x)))
      (lam x (app Ob C) (lam y (app Ob C) (lam f (app Hom C x y)
        (app trans
          (app (snd (snd (snd (snd (snd (snd D))))))
            (app fob C D F x) (app fob C D F y) (app fob C D G y) (app fob C D H y)
            (app fhom C D F x y f) (app (fst a) y) (app (fst b) y))
        (app trans
          (app ap (lam k (app Hom D (app fob C D F x) (app fob C D G y))
                    (app cmp D (app fob C D F x) (app fob C D G y) (app fob C D H y) k (app (fst b) y)))
            (app (snd a) x y f))
        (app trans
          (app sym (app (snd (snd (snd (snd (snd (snd D))))))
            (app fob C D F x) (app fob C D G x) (app fob C D G y) (app fob C D H y)
            (app (fst a) x) (app fhom C D G x y f) (app (fst b) y)))
        (app trans
          (app ap (lam k (app Hom D (app fob C D G x) (app fob C D H y))
                    (app cmp D (app fob C D F x) (app fob C D G x) (app fob C D H y) (app (fst a) x) k))
            (app (snd b) x y f))
          (app (snd (snd (snd (snd (snd (snd D))))))
            (app fob C D F x) (app fob C D G x) (app fob C D H x) (app fob C D H y)
            (app (fst a) x) (app (fst b) x) (app fhom C D H x y f))))))))))))))))))
