; Append after systems.horn. No cubical algorithm is added to the kernel.
; comp A phi tube base binds a dimension in A and tube, NOT in phi or base.
; This first fragment specifies typing and face computation; type-directed
; comp equations (Pi, Sigma, Path, Glue, universes) are still to be supplied.
(ctor comp (Tm F Tm Tm) Tm)
(rule scope.comp ((scoped (s ?d) ?n ?a) (face ?d ?phi)
    (scoped (s ?d) ?n ?t) (scoped ?d ?n ?base))
  (scoped ?d ?n (comp ?a ?phi ?t ?base)))
(rule shift.comp ((shift ?a ?k ?a2) (shift ?t ?k ?t2) (shift ?b ?k ?b2))
  (shift (comp ?a ?phi ?t ?b) ?k (comp ?a2 ?phi ?t2 ?b2)))
(rule subst.comp ((dshift ?r z ?r2) (subst ?a ?k ?r2 ?a2)
    (subst ?t ?k ?r2 ?t2) (subst ?b ?k ?r ?b2))
  (subst (comp ?a ?phi ?t ?b) ?k ?r (comp ?a2 ?phi ?t2 ?b2)))
(rule dshift.comp ((dshift ?a (s ?k) ?a2) (fshift ?phi ?k ?phi2)
    (dshift ?t (s ?k) ?t2) (dshift ?b ?k ?b2))
  (dshift (comp ?a ?phi ?t ?b) ?k (comp ?a2 ?phi2 ?t2 ?b2)))
(rule dsubst.comp ((ishift ?r z ?r2) (dsubst ?a (s ?k) ?r2 ?a2)
    (fsubst ?phi ?k ?r ?phi2) (dsubst ?t (s ?k) ?r2 ?t2) (dsubst ?b ?k ?r ?b2))
  (dsubst (comp ?a ?phi ?t ?b) ?k ?r (comp ?a2 ?phi2 ?t2 ?b2)))

(rule rhas.comp ((rctx ?d ?g ?psi) (dshiftctx ?g z ?g2)
    (fshift ?psi z ?psi2) (face ?d ?phi) (fshift ?phi z ?phi2)
    (rhas (s ?d) ?g2 ?psi2 ?a (u ?l))
    (rhas (s ?d) ?g2 (fand ?psi2 ?phi2) ?t ?a)
    (dsubst ?a z i0 ?a0) (dsubst ?a z i1 ?a1) (dsubst ?t z i0 ?t0)
    (rhas ?d ?g ?psi ?a0 (u ?l)) (rhas ?d ?g ?psi ?a1 (u ?l))
    (rhas ?d ?g ?psi ?b ?a0) (req ?d ?g (fand ?psi ?phi) ?t0 ?b ?a0))
  (rhas ?d ?g ?psi (comp ?a ?phi ?t ?b) ?a1))
(rule req.comp-face ((rhas ?d ?g ?psi (comp ?a ?phi ?t ?b) ?a1)
    (entails ?d ?psi ?phi) (dsubst ?t z i1 ?t1) (rhas ?d ?g ?psi ?t1 ?a1))
  (req ?d ?g ?psi (comp ?a ?phi ?t ?b) ?t1 ?a1))
